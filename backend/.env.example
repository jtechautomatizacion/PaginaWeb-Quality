# ==== SERVIDOR ====
PORT=4000

# ==== BASE DE DATOS ====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=group_tqc
DB_USER=root
DB_PASSWORD=TuPasswordAqui

# ==== SEGURIDAD - AUTENTICACION ====
# Clave secreta para firmar los tokens JWT del panel admin.
# Genera una propia con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA reutilices la misma clave entre clientes/instancias distintas.
JWT_SECRET=

# ==== SEGURIDAD - CORS ====
# DESARROLLO: usar "*" para permitir cualquier origen
# PRODUCCIÓN: especificar el dominio del frontend
# Ejemplo producción: CORS_ORIGIN=https://hosting-del-cliente.com
CORS_ORIGIN=*

# ==== ENTORNO ====
# Usa "development" en local, "production" en VPS
NODE_ENV=development
